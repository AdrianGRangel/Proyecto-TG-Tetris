<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proyecto base del juego TETRIS2D usando C# y OpenTK (OpenGL 4).
    El paquete System.Drawing.Common se usa SOLO en Windows para generar
    el "atlas" de letras (textura con todos los caracteres) con la que la
    interfaz dibuja el texto dentro de la ventana de OpenGL.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tetris2D</RootNamespace>
    <!-- System.Drawing solo existe en Windows: el analizador de plataformas se ignora -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Motor grafico: creacion de ventanas, eventos y OpenGL 4 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <!-- Generacion del atlas de fuente de texto (solo Windows) -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- SoundPlayer (System.Media) para los tonos WAV de la Fase 3 -->
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copiar archivos de audio al directorio de salida -->
    <None Update="Audio\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>